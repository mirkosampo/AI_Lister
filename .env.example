# Facoltativo. Copia questo file in `.env` (escluso da git) e compila solo ciò che ti serve.

# Token di lunga durata generato con:  claude setup-token
# Con questo token la CLI non deve rinnovare il login OAuth, quindi spariscono
# gli errori "Failed to refresh OAuth token" dovuti ad altri processi Claude aperti.
CLAUDE_CODE_OAUTH_TOKEN=

# Chiave gratuita di Artificial Analysis (https://artificialanalysis.ai/documentation):
# abilita Intelligence Index, prezzi, velocità e le arene immagini/video/voce.
# Si può impostare anche dalla GUI (Impostazioni).
ARTIFICIAL_ANALYSIS_API_KEY=

# Token GitHub (facoltativo): alza il limite dell'API da 60 a 5000 richieste/ora.
# Basta un token "fine-grained" senza alcun permesso: https://github.com/settings/personal-access-tokens/new
GITHUB_TOKEN=
